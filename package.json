{
  "name": "deckforge",
  "version": "0.1.0",
  "description": "Editable, themeable HTML presentation framework: static viewer, local edition mode, template editor and an embedded Copilot agent.",
  "license": "MIT",
  "author": "Ludovic Rivallain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lrivallain/deckforge.git"
  },
  "homepage": "https://github.com/lrivallain/deckforge#readme",
  "type": "module",
  "bin": {
    "deckforge": "bin/deckforge.js"
  },
  "exports": {
    ".": "./src/core/index.js",
    "./server": "./src/server/index.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "themes",
    "templates",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "lint": "node --check bin/deckforge.js && eslint .",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.16",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "vitest": "^4.1.11"
  }
}
