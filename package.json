{
  "name": "deckforge",
  "version": "0.1.0",
  "description": "Editable, themeable HTML presentation framework: static viewer, local edition mode, template editor and an embedded Copilot agent.",
  "keywords": [
    "presentation",
    "slides",
    "deck",
    "html",
    "yaml",
    "themes",
    "templates",
    "editor",
    "github-copilot",
    "cli"
  ],
  "license": "MIT",
  "author": "Ludovic Rivallain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lrivallain/deckforge.git"
  },
  "bugs": {
    "url": "https://github.com/lrivallain/deckforge/issues"
  },
  "homepage": "https://deckforge.vuptime.io/",
  "type": "module",
  "bin": {
    "deckforge": "bin/deckforge.js"
  },
  "exports": {
    ".": "./src/core/index.js",
    "./server": "./src/server/index.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "themes",
    "templates",
    "examples",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint .",
    "check": "npm run build && npm test && npm run test:e2e",
    "docs:dev": "node scripts/docs-demo.js && vitepress dev docs",
    "docs:build": "node scripts/docs-demo.js && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:screenshots": "node scripts/screenshots.js && node scripts/icons.js"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jszip": "^3.10.2",
    "pptxgenjs": "^4.0.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@github/copilot-sdk": "^1.0.16",
    "playwright": "^1.63.0"
  }
}
